{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dental-hospital-management-system",
  "compatibility_date": "2026-09-11",
  "assets": {
    "directory": ".",
    "exclude": [
      "node_modules",
      "node_modules/**",
      "**/node_modules/**",
      ".git",
      ".git/**",
      "*.log",
      ".env*"
    ]
  }
}
