{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dental-hospital-management-system",
  "main": "worker.js",
  "compatibility_date": "2026-09-11",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "single-page-app",
    "not_found_handling": "single-page-app",
    "exclude": [
      ".git/**",
      ".gitignore",
      "node_modules/**",
      "package.json",
      "package-lock.json",
      "USER_MANUAL.md",
      "supabase-schema.sql"
    ]
  }
}

